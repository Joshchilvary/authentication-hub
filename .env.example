# =============================================================================
# Authentication Hub — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your local or production values.
# Do not commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Required: Secret key for cryptographic signing.
# Generate a strong value: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In production, this MUST be set to a secure, non-empty value.
# -----------------------------------------------------------------------------
SECRET_KEY=

# -----------------------------------------------------------------------------
# Debug mode. NEVER set to True in production.
# -----------------------------------------------------------------------------
DEBUG=True

# -----------------------------------------------------------------------------
# Allowed hosts (space-separated). In production, set this to your domain(s).
# -----------------------------------------------------------------------------
ALLOWED_HOSTS=localhost 127.0.0.1

# -----------------------------------------------------------------------------
# Database configuration
# -----------------------------------------------------------------------------
# For production PostgreSQL, use DATABASE_URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Alternatively, use individual variables (SQLite defaults shown):
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
DATABASE_URL=

# -----------------------------------------------------------------------------
# Cloudinary media storage (production)
# -----------------------------------------------------------------------------
# Leave empty to use local filesystem storage in development.
# In production, configure with your Cloudinary credentials.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Email configuration
# -----------------------------------------------------------------------------
# Production uses Brevo HTTP API; configure via Render environment variables.
# Replace with your verified Brevo sender email in production.
DEFAULT_FROM_EMAIL=your-verified-sender@example.com
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_TIMEOUT=10

# -----------------------------------------------------------------------------
# Session configuration
# -----------------------------------------------------------------------------
# Session cookie age in seconds (default: 1209600 = 2 weeks)
SESSION_COOKIE_AGE=1209600

# Idle session timeout in seconds (default: 300 = 5 minutes)
IDLE_SESSION_TIMEOUT=300

# -----------------------------------------------------------------------------
# Production security (enable when deploying with HTTPS)
# -----------------------------------------------------------------------------
# Enforce HTTPS redirect
SECURE_SSL_REDIRECT=False

# Secure cookies (require HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HTTP-only cookies (prevent JavaScript access)
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# HSTS (enable in production with HTTPS)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Security headers
SECURE_CONTENT_TYPE_NOSNIFF=False
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=no-referrer-when-downgrade

# -----------------------------------------------------------------------------
# Trusted proxy configuration (for production deployments behind a reverse proxy)
# -----------------------------------------------------------------------------
# Comma-separated list of proxy IP addresses that set X-Forwarded-For.
# Leave empty to ignore X-Forwarded-For and use REMOTE_ADDR directly.
# Example: TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
TRUSTED_PROXY_IPS=

# -----------------------------------------------------------------------------
# CSRF trusted origins (for production HTTPS deployments)
# -----------------------------------------------------------------------------
# Space-separated list of origins trusted for CSRF.
# Example: CSRF_TRUSTED_ORIGINS=https://example.com https://www.example.com
CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Secure proxy SSL header (enable only when behind a trusted reverse proxy)
# -----------------------------------------------------------------------------
# Format: "HTTP_X_FORWARDED_PROTO,https"
# Example: SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=
